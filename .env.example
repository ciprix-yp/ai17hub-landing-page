# Doar NUMELE variabilelor; valorile stau in Keychain, nu aici.
# Se pun cu:  secret set ai17hub-site <VAR>
# Se folosesc cu:  secret run ai17hub-site -- <comanda>

# Formular de pre-lansare (Cloudflare Turnstile + Resend)
# Build (cheie publica a widget-ului; local de test: cheia de test Cloudflare 1x00000000000000000000AA)
PUBLIC_TURNSTILE_SITE_KEY=
# Runtime (secrete / variabile Cloudflare Pages, local in .dev.vars)
TURNSTILE_SECRET_KEY=
RESEND_API_KEY=
# Destinatarul notificarilor (implicit office@ai17hub.ro)
LEAD_NOTIFY_TO=
# Expeditorul emailurilor (implicit AI17 HUB <noreply@ai17hub.ro>)
LEAD_FROM=
