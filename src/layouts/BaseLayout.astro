---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
}

const {
  title = 'Avram Iancu 17 · HUB Constanța — Smart Urban Regeneration',
  description = 'Prima infrastructură mixtă din Dobrogea pentru arhitecți, ingineri, designeri și firme tech. Incubare, Digital Lab, Evenimente, Parteneri B2B. Constanța, 2026.',
  ogImage = 'https://ai17hub.ro/og-image.jpg',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="ro">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />

    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalURL} />

    <!-- Open Graph -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content="O clădire din 1906. Un hub pentru Constanța de mâine." />
    <meta property="og:description" content="Aplicații pentru incubare deschise. Spații de lucru, comunitate, Digital Lab BIM·LIDAR·Urban Intelligence." />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content="ro_RO" />
    <meta property="og:site_name" content="AI17 HUB" />

    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/logo.jpg" />
    <meta name="theme-color" content="#1C1C1C" />

    <!-- Fonts — Google Fonts (self-hosted în producție finală) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Barlow:wght@400;600;700&display=swap"
      rel="stylesheet"
    />

    <!-- JSON-LD Structured Data -->
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "name": "Avram Iancu 17 HUB",
        "description": "Prima infrastructură mixtă din Dobrogea pentru arhitecți, ingineri, designeri și firme tech.",
        "url": "https://ai17hub.ro",
        "telephone": "+40-723-171-168",
        "email": "office@ai17hub.ro",
        "address": {
          "@type": "PostalAddress",
          "streetAddress": "Strada Avram Iancu 17",
          "addressLocality": "Constanța",
          "addressCountry": "RO"
        },
        "parentOrganization": {
          "@type": "Organization",
          "name": "MASSTUDIO SRL"
        },
        "openingHours": "Mo-Su 00:00-24:00"
      }
    </script>
  </head>

  <body>
    <a href="#main-content" class="skip-link">Sari la conținut</a>
    <slot />

    <!-- Lenis smooth scroll — inițializat global -->
    <script>
      import Lenis from 'lenis';

      const prefersReducedMotion = window.matchMedia(
        '(prefers-reduced-motion: reduce)'
      ).matches;

      if (!prefersReducedMotion) {
        const lenis = new Lenis({
          duration: 1.2,
          easing: (t: number) =>
            Math.min(1, 1.001 - Math.pow(2, -10 * t)),
          orientation: 'vertical',
          smoothWheel: true,
        });

        function raf(time: number) {
          lenis.raf(time);
          requestAnimationFrame(raf);
        }
        requestAnimationFrame(raf);

        // Expune lenis global pentru componente GSAP
        (window as unknown as Record<string, unknown>)['lenis'] = lenis;
      }
    </script>

    <!-- ── Global dynamic image rotator ──────────────────────────────────── -->
    <script>
      if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const ALL_RENDERS: string[] = Array.from({ length: 15 }, (_, i) =>
          `/renders/render-${String(i + 1).padStart(2, '0')}.jpg`
        );

        function shuffle(arr: string[]): string[] {
          const a = [...arr];
          for (let i = a.length - 1; i > 0; i--) {
            const j = Math.floor(Math.random() * (i + 1));
            [a[i], a[j]] = [a[j], a[i]];
          }
          return a;
        }

        // Reține ce render apare în fiecare slot — previne duplicate
        const slotCurrentRender = new Map<HTMLImageElement, string>();

        function getNextRender(): string {
          const inUse = new Set([
            ...slotCurrentRender.values(),
            // Exclude și render-ul curent din hero GSAP
            ...Array.from(
              document.querySelectorAll<HTMLImageElement>('.hero-slide')
            )
              .filter(img => parseFloat(img.style.opacity || '0') > 0.1)
              .map(img => img.src.split('/').pop() ?? ''),
          ]);

          const available = ALL_RENDERS.filter(
            r => !Array.from(inUse).some(used => r.includes(used.replace('/renders/', '')))
          );

          const pool = available.length > 0 ? available : ALL_RENDERS;
          return pool[Math.floor(Math.random() * pool.length)];
        }

        async function transitionSlot(img: HTMLImageElement): Promise<void> {
          const newSrc = getNextRender();

          img.style.transition = 'opacity 0.7s ease';
          img.style.opacity = '0';

          await new Promise<void>(r => setTimeout(r, 700));

          // Preload înainte de swap
          await new Promise<void>(r => {
            const pre = new Image();
            pre.onload = () => r();
            pre.onerror = () => r();
            pre.src = newSrc;
          });

          img.src = newSrc;
          slotCurrentRender.set(img, newSrc.split('/').pop() ?? '');
          img.style.opacity = '1';
        }

        function startRotator() {
          const slots = Array.from(
            document.querySelectorAll<HTMLImageElement>('[data-dynamic-img]')
          );
          if (slots.length === 0) return;

          // Inițializează maparea
          slots.forEach(img => {
            slotCurrentRender.set(img, img.src.split('/').pop() ?? '');
          });

          // Shuffled queue pentru ordine aleatorie
          let queue = shuffle(slots.map((_, i) => i));
          let queuePos = 0;

          async function tick() {
            const slotIdx = queue[queuePos % queue.length];
            queuePos++;
            // Rearanjează queue la fiecare ciclu complet
            if (queuePos % queue.length === 0) queue = shuffle(slots.map((_, i) => i));

            const slot = slots[slotIdx];
            if (slot) await transitionSlot(slot);

            // Pauză între tranziții — NICIODATĂ 2 simultan
            setTimeout(tick, 2800);
          }

          // Pornește după 6s — lasă hero-ul să înceapă primul
          setTimeout(tick, 6000);
        }

        if (document.readyState === 'loading') {
          document.addEventListener('DOMContentLoaded', startRotator);
        } else {
          startRotator();
        }
      }
    </script>
  </body>
</html>
