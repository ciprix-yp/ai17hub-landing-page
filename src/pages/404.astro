---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Pagina nu există · AI17 HUB"
  description="Adresa căutată nu există pe ai17hub.ro."
  noindex
>
  <main id="main-content" style="background: #1C1C1C; min-height: 100vh; padding-top: 140px; padding-bottom: 80px;">
    <div class="section-container">
      <div class="max-w-2xl mx-auto text-center">
        <p class="eyebrow mb-4">404</p>
        <h1 class="font-editorial text-sand mb-4" style="font-size: clamp(1.75rem, 4vw, 2.75rem);">
          Pagina nu există.
        </h1>
        <p class="font-sans text-grey mb-10" style="font-size: 1rem; line-height: 1.7;">
          Adresa e greșită sau pagina a fost mutată.
        </p>
        <a href="/" class="btn-primary">Înapoi la pagina principală</a>
      </div>
    </div>
  </main>
</BaseLayout>
