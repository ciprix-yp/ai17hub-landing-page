---
const floors = [
  {
    id: 'parter',
    label: 'Parter',
    title: 'Parter — Public, vibrant, punct de întâlnire.',
    body: 'Bistro · Recepție · Lobby · 2 Săli multifuncționale (65–100 locuri) · Atelier 3D + Plotter. Deschis publicului în zilele de evenimente.',
    images: ['/renders/parter-01.jpg', '/renders/parter-02.jpg', '/renders/parter-03.jpg'],
    imageAlt: 'Parter AI17 HUB — zona publică și recepție',
    specs: ['2 Săli multifuncționale (65–100 locuri)', 'Bistro: 60 locuri', 'Atelier 3D și machetare', 'Echipamente de scanare'],
  },
  {
    id: 'supanta',
    label: 'Supantă',
    title: 'Supantă — Privată, productivă.',
    body: '',
    images: [
      '/renders/supanta-01.jpg', '/renders/supanta-02.jpg', '/renders/supanta-03.jpg',
      '/renders/supanta-04.jpg', '/renders/supanta-05.jpg', '/renders/supanta-06.jpg',
      '/renders/supanta-07.jpg', '/renders/supanta-08.jpg', '/renders/supanta-09.jpg',
      '/renders/supanta-10.jpg',
    ],
    imageAlt: 'Supantă AI17 HUB — birouri private și săli de ședință',
    specs: ['Săli de ședință', 'Zonă de relaxare', 'Spațiu de joacă pentru copii', '4 birouri private (2–12 persoane)', 'Acces 24/7'],
  },
  {
    id: 'mansarda',
    label: 'Mansardă',
    title: 'Mansardă — Luminoasă, deschisă. Inima comunității.',
    body: 'Open space 36 posturi',
    images: ['/renders/mansarda-01.jpg', '/renders/mansarda-02.jpg', '/renders/mansarda-03.jpg'],
    imageAlt: 'Mansardă AI17 HUB — open space cu grinzi originale din 1906',
    specs: ['Lab BIM/LIDAR', 'Grinzi de lemn originale 1906', 'Birouri individuale (1–3 locuri)', 'Săli de ședințe', 'Bibliotecă de produse — exclusiv parteneri'],
  },
];
---

<section id="spatii" class="bg-ink py-20 md:py-28" aria-labelledby="spaces-title">
  <div class="section-container">

    <div class="mb-12 text-center reveal-s">
      <p class="eyebrow mb-4">SPAȚIILE</p>
      <h2
        id="spaces-title"
        class="font-editorial text-sand"
        style="font-size: clamp(1.75rem, 4vw, 2.75rem);"
      >
        Trei niveluri. Trei caractere.<br />O singură comunitate.
      </h2>
      <p class="font-sans text-grey mt-4 max-w-lg mx-auto" style="font-size: 1rem; line-height: 1.65;">
        Parter public · Supantă privată · Mansardă productivă.<br />
        Toate conectate prin scara elicoidală centrală.
      </p>
    </div>

    <!-- Tab navigation -->
    <div class="reveal-s">
      <div
        class="flex gap-0 border-b mb-0"
        style="border-color: rgba(255,255,255,0.1);"
        role="tablist"
        aria-label="Nivelurile clădirii"
      >
        {floors.map((floor, i) => (
          <button
            class="spaces-tab font-sans font-bold text-base px-6 py-3 transition-colors relative"
            style={`color: ${i === 0 ? '#E8DDD0' : '#888888'}; background: none; border: none; cursor: pointer;`}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
            aria-controls={`panel-${floor.id}`}
            id={`tab-${floor.id}`}
            data-floor={floor.id}
          >
            {floor.label}
            {i === 0 && (
              <span
                class="spaces-tab-indicator absolute bottom-0 left-0 right-0 h-0.5 bg-accent"
                style="transition: opacity 0.2s;"
              />
            )}
          </button>
        ))}
      </div>

      <!-- Tab panels -->
      {floors.map((floor, i) => (
        <div
          id={`panel-${floor.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${floor.id}`}
          class="spaces-panel grid grid-cols-1 md:grid-cols-2 gap-8 pt-0"
          style={`display: ${i === 0 ? 'grid' : 'none'}; min-height: 400px;`}
        >
          <!-- Text -->
          <div class="flex flex-col justify-center py-10 md:py-12 pr-0 md:pr-8">
            <h3 class="font-sans font-bold text-sand mb-4" style="font-size: 1.375rem; line-height: 1.3;">
              {floor.title}
            </h3>
            {floor.body && (
              <p class="font-sans text-grey mb-8" style="font-size: 1rem; line-height: 1.7;">
                {floor.body}
              </p>
            )}
            <ul class="space-y-2">
              {floor.specs.map((spec) => (
                <li class="flex items-center gap-3 font-sans text-grey text-sm">
                  <span class="w-1.5 h-1.5 rounded-full bg-accent flex-shrink-0" aria-hidden="true"></span>
                  {spec}
                </li>
              ))}
            </ul>
          </div>

          <!-- Floor slideshow — poze strict din etajul respectiv -->
          <div
            class="floor-slideshow relative overflow-hidden"
            data-floor-id={floor.id}
            style="min-height: 320px;"
          >
            {floor.images.map((src, j) => (
              <img
                src={src}
                alt={j === 0 ? floor.imageAlt : ''}
                class="floor-slide absolute inset-0 w-full h-full object-cover"
                style={`opacity: ${j === 0 ? 1 : 0}; transition: opacity 0.7s ease;`}
                loading={i === 0 && j === 0 ? 'eager' : 'lazy'}
                decoding="async"
              />
            ))}
          </div>
        </div>
      ))}
    </div>

    <!-- CTA -->
    <div class="mt-10 text-center reveal-s">
      <a href="#aplica" class="btn-outline">
        Programează un tur ghidat →
      </a>
    </div>

  </div>
</section>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  // ── Per-floor slideshows ─────────────────────────────────────────────────
  const floorTimers = new Map<string, ReturnType<typeof setInterval>>();
  const floorCurrentIndex = new Map<string, number>();

  function startFloorRotator(floorId: string) {
    if (reducedMotion) return;

    const slideshow = document.querySelector<HTMLElement>(
      `.floor-slideshow[data-floor-id="${floorId}"]`
    );
    if (!slideshow) return;

    const slides = Array.from(
      slideshow.querySelectorAll<HTMLImageElement>('.floor-slide')
    );
    if (slides.length <= 1) return;

    let idx = floorCurrentIndex.get(floorId) ?? 0;

    const timer = setInterval(() => {
      slides[idx].style.opacity = '0';
      idx = (idx + 1) % slides.length;
      slides[idx].style.opacity = '1';
      floorCurrentIndex.set(floorId, idx);
    }, 3800);

    floorTimers.set(floorId, timer);
  }

  function stopFloorRotator(floorId: string) {
    const timer = floorTimers.get(floorId);
    if (timer !== undefined) {
      clearInterval(timer);
      floorTimers.delete(floorId);
    }
  }

  // Start rotator for initially active floor
  startFloorRotator('parter');

  // ── Tab switching ────────────────────────────────────────────────────────
  const tabs = document.querySelectorAll<HTMLButtonElement>('.spaces-tab');
  const panels = document.querySelectorAll<HTMLElement>('.spaces-panel');

  tabs.forEach((tab) => {
    tab.addEventListener('click', () => {
      const newFloorId = tab.dataset.floor!;

      // Find which floor was previously active and stop its rotator
      tabs.forEach((t) => {
        if (t.getAttribute('aria-selected') === 'true' && t !== tab) {
          stopFloorRotator(t.dataset.floor!);
        }

        t.style.color = '#888888';
        t.setAttribute('aria-selected', 'false');
        const indicator = t.querySelector<HTMLElement>('.spaces-tab-indicator');
        if (indicator) indicator.style.opacity = '0';
      });

      panels.forEach((p) => {
        p.style.display = 'none';
        p.style.opacity = '0';
      });

      // Activate selected tab
      tab.style.color = '#E8DDD0';
      tab.setAttribute('aria-selected', 'true');
      const activeIndicator = tab.querySelector<HTMLElement>('.spaces-tab-indicator');
      if (activeIndicator) activeIndicator.style.opacity = '1';

      const activePanel = document.getElementById(`panel-${newFloorId}`);
      if (activePanel) {
        activePanel.style.display = 'grid';
        requestAnimationFrame(() => {
          activePanel.style.transition = 'opacity 0.3s ease';
          activePanel.style.opacity = '1';
        });
      }

      // Start rotator for newly active floor
      startFloorRotator(newFloorId);
    });
  });

  // ── Reveal on scroll ─────────────────────────────────────────────────────
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  if (!reducedMotion) {
    gsap.utils.toArray<HTMLElement>('#spatii .reveal-s').forEach((el) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 24 },
        {
          opacity: 1,
          y: 0,
          duration: 0.65,
          ease: 'power3.out',
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        }
      );
    });
  } else {
    document.querySelectorAll<HTMLElement>('#spatii .reveal-s').forEach((el) => {
      el.style.opacity = '1';
    });
  }
</script>
