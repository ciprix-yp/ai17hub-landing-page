---
const cards = [
  {
    tag: 'INCUBAT',
    interest: 'incubare',
    title: 'Spațiul tău de lucru + comunitatea care îți crește afacerea.',
    body: 'De la un post în open space până la birou pentru 12 persoane. Pachete de la 200 €/lună. Aplici în 15 minute.',
    cta: 'Vreau să aplic',
    accent: 'De la 200 €/lună',
    icon: '⬡',
  },
  {
    tag: 'PARTENER',
    interest: 'partener',
    title: '100+ decidenți arhitecturali. Sub același acoperiș. În fiecare zi.',
    body: 'Specificarea materialelor se decide de arhitect, nu de clientul final. Biblioteca de Produse · Exclusivitate pe categorie · 3 tier-uri de parteneriat.',
    cta: 'Descarcă pachetul',
    accent: '100+ profesioniști',
    icon: '◈',
  },
  {
    tag: 'EVENIMENT',
    interest: 'evenimente',
    title: 'Săli pentru 65–90 de persoane în centrul Constanței.',
    body: 'Sala Mare · Sala Teatru · Lobby. Conferințe, workshop-uri, lansări, spectacole. Calendar activ din Septembrie 2026.',
    cta: 'Înscrie-mă pentru noutăți',
    accent: '65–90 locuri',
    icon: '◇',
  },
  {
    tag: 'LAB CLIENT',
    interest: 'lab',
    title: 'BIM · LIDAR · Urban Intelligence · Eficiență Energetică.',
    body: 'Servicii tehnice pentru proiecte de anvergură. Echipament de ultimă generație. Expertiză MASSTUDIO cu proiecte în Chicago, Genova, Veneția.',
    cta: 'Trimite un brief',
    accent: '4 servicii tehnice',
    icon: '◉',
  },
];
---

<section id="verticale" class="bg-charcoal py-20 md:py-28" aria-labelledby="verticals-title">
  <div class="section-container">

    <div class="mb-14 text-center">
      <p class="eyebrow reveal-v mb-4">PENTRU CINE ESTE AI17HUB</p>
      <h2
        id="verticals-title"
        class="font-editorial text-sand reveal-v"
        style="font-size: clamp(1.75rem, 4vw, 2.75rem);"
      >
        Patru trasee. O singură comunitate.
      </h2>
    </div>

    <!-- Grid 2x2 — carduri separate cu floating effect -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-5 md:gap-6" role="list">
      {cards.map((card) => (
        <article
          class="vertical-card reveal-v flex flex-col"
          data-interest={card.interest}
          role="listitem"
          style="background: #1C1C1C; border: 1px solid rgba(255,255,255,0.08); min-height: 360px;"
        >
          <!-- Body card -->
          <div class="p-8 md:p-10 flex-1">
            <div class="flex items-center justify-between mb-5">
              <span class="eyebrow text-accent">{card.tag}</span>
              <span class="text-grey opacity-40" style="font-size: 1.25rem;" aria-hidden="true">{card.icon}</span>
            </div>

            <h3 class="font-sans font-bold text-sand mb-4" style="font-size: 1.1875rem; line-height: 1.35;">
              {card.title}
            </h3>
            <p class="font-sans text-grey" style="font-size: 0.9375rem; line-height: 1.7;">
              {card.body}
            </p>

            <!-- Cifră accent -->
            <div class="mt-6">
              <span class="font-editorial text-accent font-bold" style="font-size: 1.625rem; line-height: 1;">
                {card.accent}
              </span>
            </div>
          </div>

        </article>
      ))}
    </div>

    <!-- CTA unic la finalul secțiunii -->
    <div class="mt-14 text-center reveal-v">
      <p class="font-sans text-grey mb-6" style="font-size: 1rem; line-height: 1.7;">
        Indiferent de traseu — spațiu de lucru, parteneriat, eveniment sau servicii tehnice —<br class="hidden md:block" />
        primul pas e o conversație.
      </p>
      <a
        href="#aplica"
        class="btn-primary inline-flex items-center gap-3"
        style="font-size: 1rem; padding: 1rem 2.5rem; letter-spacing: 0.04em;"
      >
        Hai să vorbim
        <span style="font-size: 1.1rem;">→</span>
      </a>
    </div>

  </div>
</section>

<style>
  .vertical-card {
    box-shadow:
      0 4px 16px rgba(0, 0, 0, 0.45),
      0 1px 4px rgba(0, 0, 0, 0.6);
    transform: translateY(0) scale(1);
    transition:
      transform 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1),
      border-color 0.25s;
  }

  .vertical-card:hover {
    transform: translateY(-7px) scale(1.007);
    box-shadow:
      0 20px 48px rgba(0, 0, 0, 0.55),
      0 4px 12px rgba(0, 0, 0, 0.5),
      0 0 0 1px rgba(0, 230, 118, 0.2);
    border-color: rgba(0, 230, 118, 0.22) !important;
  }

  .vertical-card:hover .cta-arrow {
    transform: translateX(5px);
  }

  @media (prefers-reduced-motion: reduce) {
    .vertical-card {
      transition: none;
      transform: none !important;
    }
  }
</style>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  // Reveal animație la scroll
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.utils.toArray<HTMLElement>('#verticale .reveal-v').forEach((el, i) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 36 },
        {
          opacity: 1,
          y: 0,
          duration: 0.65,
          ease: 'power3.out',
          delay: (i % 2) * 0.08,
          scrollTrigger: { trigger: el, start: 'top 88%', once: true },
        }
      );
    });
  } else {
    document.querySelectorAll<HTMLElement>('#verticale .reveal-v').forEach((el) => {
      el.style.opacity = '1';
    });
  }

  // Pre-selectează interesul în formular la click pe CTA
  document.querySelectorAll<HTMLAnchorElement>('.card-cta-link').forEach((link) => {
    link.addEventListener('click', () => {
      const interest = link.dataset.interest;
      if (!interest) return;

      // Găsește radio button-ul corespunzător și îl selectează
      const radio = document.querySelector<HTMLInputElement>(
        `input[name="interest"][value="${interest}"]`
      );
      if (radio) {
        radio.checked = true;
        // Trigger schimbare vizuală
        radio.dispatchEvent(new Event('change', { bubbles: true }));
      }
    });
  });
</script>
