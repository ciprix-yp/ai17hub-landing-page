---
// Separator grafic între secțiunea narativă și grid-ul de trasee
// Folosește render-10 ca fundalul cu overlay puternic
---

<div
  class="relative w-full overflow-hidden"
  style="height: 220px;"
  aria-hidden="true"
>
  <!-- Imagine de fundal -->
  <img
    src="/renders/render-10.jpg"
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    style="object-position: center 40%;"
    loading="lazy"
    data-dynamic-img
  />

  <!-- Overlay gradient puternic -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, #1C1C1C 0%, rgba(28,28,28,0.2) 50%, rgba(42,42,42,0.95) 100%);"
  ></div>

  <!-- Text centrat -->
  <div class="absolute inset-0 flex items-center justify-center">
    <p
      class="font-sans font-bold text-accent text-center"
      style="font-size: 0.75rem; letter-spacing: 0.28em; text-transform: uppercase; text-shadow: 0 1px 8px rgba(0,0,0,0.9);"
    >
      Smart Urban Regeneration · Constanța · 2026
    </p>
  </div>
</div>
