---
// Separator grafic între secțiunea narativă și grid-ul de trasee
// Folosește render-10 ca fundalul cu overlay puternic
---

<div
  class="relative w-full overflow-hidden"
  style="height: 220px;"
  aria-hidden="true"
>
  <!-- Imagine de fundal -->
  <img
    src="/renders/render-10.jpg"
    alt=""
    class="absolute inset-0 w-full h-full object-cover"
    style="object-position: center 40%;"
    loading="lazy"
  />

  <!-- Overlay gradient puternic -->
  <div
    class="absolute inset-0"
    style="background: linear-gradient(to bottom, #1C1C1C 0%, rgba(28,28,28,0.2) 50%, rgba(42,42,42,0.95) 100%);"
  ></div>

  <!-- Linia infinită centrată -->
  <div class="absolute inset-0 flex flex-col items-center justify-center gap-4">
    <svg viewBox="0 0 320 24" fill="none" xmlns="http://www.w3.org/2000/svg" style="width: 280px; height: 24px;">
      <path
        d="M0 12 Q 80 2, 160 12 T 320 12"
        stroke="#00E676"
        stroke-width="1.5"
        fill="none"
        pathLength="100"
        stroke-dasharray="100"
        stroke-dashoffset="0"
      />
    </svg>
    <p
      class="font-sans text-grey text-center"
      style="font-size: 0.6875rem; letter-spacing: 0.22em; text-transform: uppercase;"
    >
      Smart Urban Regeneration · Constanța · 2026
    </p>
  </div>
</div>
