---
// Imagini pornire pentru galeria MASSTUDIO — vor fi rotite dinamic
const galleryImages = [
  { src: '/renders/render-04.jpg', alt: 'Proiect MASSTUDIO — spațiu arhitectural' },
  { src: '/renders/render-06.jpg', alt: 'Proiect MASSTUDIO — spațiu de lucru' },
  { src: '/renders/render-09.jpg', alt: 'Proiect MASSTUDIO — interior design' },
  { src: '/renders/render-11.jpg', alt: 'Proiect MASSTUDIO — detaliu arhitectural' },
];
---

<section id="echipa" class="bg-ink py-20 md:py-28" aria-labelledby="masstudio-title">
  <div class="section-container">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-12 md:gap-16 items-center">

      <!-- Text -->
      <div class="reveal-m">
        <p class="eyebrow mb-6">CINE CONSTRUIEȘTE AI17</p>
        <h2
          id="masstudio-title"
          class="font-editorial text-sand mb-6"
          style="font-size: clamp(1.75rem, 3.5vw, 2.5rem); line-height: 1.2;"
        >
          Proiect MASSTUDIO.<br />Experiență internațională.<br />Rădăcini în Constanța.
        </h2>
        <p class="font-sans text-grey mb-8" style="font-size: 1rem; line-height: 1.75;">
          AI17 Hub este proiectul fondator al MASSTUDIO SRL, firmă de arhitectură
          cu proiecte în Chicago, Genova, Veneția și România. Arhitect coordonator:
          Mihai Stebingăr — 15+ ani experiență internațională în proiecte rezidențiale,
          urbane și de reabilitare patrimoniu.
        </p>
        <a
          href="https://www.instagram.com/"
          target="_blank"
          rel="noopener noreferrer"
          class="font-sans font-semibold text-accent text-sm hover:underline transition-colors"
          aria-label="Urmărește jurnalul de proiect al AI17 HUB pe Instagram"
        >
          Urmărește jurnalul de proiect →
        </a>
      </div>

      <!-- Galerie 2×2 -->
      <div class="grid grid-cols-2 gap-2 reveal-m">
        {galleryImages.map((img) => (
          <div
            class="relative overflow-hidden group"
            style="aspect-ratio: 1 / 1;"
          >
            <img
              src={img.src}
              alt={img.alt}
              class="w-full h-full object-cover transition-transform duration-500 group-hover:scale-[1.04]"
              loading="lazy"
              data-dynamic-img
            />
            <div
              class="absolute inset-0 opacity-0 group-hover:opacity-100 transition-opacity duration-300 pointer-events-none"
              style="background: rgba(0, 230, 118, 0.08);"
              aria-hidden="true"
            ></div>
          </div>
        ))}
      </div>

    </div>
  </div>
</section>

<script>
  import gsap from 'gsap';
  import { ScrollTrigger } from 'gsap/ScrollTrigger';
  gsap.registerPlugin(ScrollTrigger);

  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    gsap.utils.toArray<HTMLElement>('#echipa .reveal-m').forEach((el, i) => {
      gsap.fromTo(
        el,
        { opacity: 0, y: 28 },
        {
          opacity: 1,
          y: 0,
          duration: 0.7,
          ease: 'power3.out',
          delay: i * 0.12,
          scrollTrigger: { trigger: el, start: 'top 85%', once: true },
        }
      );
    });
  } else {
    document.querySelectorAll<HTMLElement>('#echipa .reveal-m').forEach((el) => {
      el.style.opacity = '1';
    });
  }
</script>
